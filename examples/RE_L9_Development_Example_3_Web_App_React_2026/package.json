{
  "name": "expense-tracker-react-express",
  "version": "2.1.0",
  "private": true,
  "description": "A realistic, annotated full-stack TypeScript expense tracker for university teaching",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && tsc -p web/tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "start": "node dist/server.js",
    "test": "tsc -p tsconfig.server.json && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.2.7"
  }
}
